# OpenAI-compatible LLM endpoint for Ariadne.
# Copy to .env and fill values. Never commit .env.
#
# 将此文件复制为 .env 并填写。切勿提交 .env。
# BASE_URL = prefix before /chat/completions（到 /chat/completions 之前的前缀）
# LongCat: https://api.longcat.chat/openai/v1
# OpenAI:  https://api.openai.com/v1
# Docs: README.md · README.zh-CN.md · docs/USAGE_CLI.md · docs/zh/USAGE_CLI.md

BASE_URL=https://api.longcat.chat/openai/v1
API_KEY=your-api-key-here
MODEL=LongCat-2.0

# Web /workspace binding (docs/design/web-workspace.md):
#   project  = serve cwd shared by all sessions (default, Codex-like)
#   per_user = each web account gets data_dir/web/users/<user>/workspace
# ARIADNE_WEB_WORKSPACE_MODE=project
