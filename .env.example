# OpenAI-compatible LLM endpoint for Ariadne.
# Copy to .env and fill values. Never commit .env.

# Base URL must be the prefix before /chat/completions
# LongCat example: https://api.longcat.chat/openai/v1
# OpenAI example:  https://api.openai.com/v1
BASE_URL=https://api.longcat.chat/openai/v1
API_KEY=your-api-key-here
MODEL=LongCat-2.0
